{
  "mcpServers": {
    "liuyao": {
      "command": "uvx",
      "args": [
        "--python",
        "3.11",
        "--from",
        "https://github.com/zhishengyk/liuyao/releases/download/v0.6.6/liuyao_mcp-0.6.6-py3-none-any.whl",
        "liuyao-mcp"
      ],
      "startup_timeout_sec": 180,
      "env": {
        "UV_CONCURRENT_INSTALLS": "1"
      }
    }
  }
}
